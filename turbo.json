{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": ["DEVELOPER_DIR"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "passThroughEnv": ["INCLUDE", "LIB", "LIBPATH", "CLAUDEXOR_SKIP_WIN32_CONPTY_BUILD"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
